# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force shell scripts and configs to use LF
*.sh text eol=lf
*.scad text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.example text eol=lf
*.conf text eol=lf

# Binary files
*.jpg binary
*.png binary
*.stl binary
*.bin binary