# ESPHome secrets for firmware/esphome_smdc_bridge.yaml
# Copy to `secrets.yaml` next to the firmware YAML and fill in real values.
# `secrets.yaml` is git-ignored; never commit real credentials.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant native API encryption key (32 bytes, base64).
# PLACEHOLDER - NOT A SECRET: the value below is the base64 of the 32 ASCII bytes
# "EXAMPLE-ONLY-NOT-A-SECRET-CHANGE". It is only here so that `esphome config` and
# `esphome compile` accept the example file (ESPHome rejects anything that is not a
# base64-encoded 32-byte key, and also the all-zeros key). It is public and must
# NEVER be flashed to a device. Replace it with your own key:
#   openssl rand -base64 32
api_encryption_key: "RVhBTVBMRS1PTkxZLU5PVC1BLVNFQ1JFVC1DSEFOR0U="

# Over-the-air update password.
ota_password: "REPLACE_WITH_STRONG_OTA_PASSWORD"

# MQTT broker (e.g. Mosquitto on the sovereign stack).
mqtt_broker: "10.42.0.1"
mqtt_user: "sovereign-telemetry"
mqtt_password: "REPLACE_WITH_MQTT_PASSWORD"
