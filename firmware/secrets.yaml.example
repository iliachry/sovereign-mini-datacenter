# ESPHome secrets for firmware/esphome_smdc_bridge.yaml
# Copy to `secrets.yaml` next to the firmware YAML and fill in real values.
# `secrets.yaml` is git-ignored; never commit real credentials.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant native API encryption key (32 bytes, base64).
# Generate with:  openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY="

# Over-the-air update password.
ota_password: "REPLACE_WITH_STRONG_OTA_PASSWORD"

# MQTT broker (e.g. Mosquitto on the sovereign stack).
mqtt_broker: "10.42.0.1"
mqtt_user: "sovereign-telemetry"
mqtt_password: "REPLACE_WITH_MQTT_PASSWORD"
