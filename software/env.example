# ====================================================================
# Sovereign Mini Datacenter — Environment Configuration Template
# Copy to .env and fill in all values before running setup.sh
# ====================================================================

# ── TLS / Let's Encrypt ─────────────────────────────────────────────
# Email used for ACME certificate registration
ACME_EMAIL=admin@yourdomain.com

# ── Domain Names ────────────────────────────────────────────────────
# Set these to your actual public or LAN domain names.
# For LAN-only: use *.local (self-signed) or split-horizon DNS.
DOMAIN_TRAEFIK=traefik.yourdomain.com
DOMAIN_WEBUI=ai.yourdomain.com
DOMAIN_GITLAB=gitlab.yourdomain.com
DOMAIN_PROJECTS=projects.yourdomain.com
DOMAIN_NEXTCLOUD=cloud.yourdomain.com
DOMAIN_VAULT=vault.yourdomain.com
DOMAIN_GRAFANA=grafana.yourdomain.com
DOMAIN_PROMETHEUS=metrics.yourdomain.com

# ── Traefik Dashboard Auth ───────────────────────────────────────────
# Generate with: echo $(htpasswd -nb admin yourpassword) | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$changeme$$replace_this_with_htpasswd_output

# ── Open-WebUI ───────────────────────────────────────────────────────
WEBUI_SECRET_KEY=change_me_to_a_strong_random_string_min_32_chars

# ── GitLab CE ────────────────────────────────────────────────────────
# No additional secrets needed beyond domain; root password set on first login.

# ── OpenProject ──────────────────────────────────────────────────────
OPENPROJECT_SECRET=change_me_to_a_strong_random_string_min_64_chars

# ── Nextcloud ────────────────────────────────────────────────────────
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_strong_password

# ── Vaultwarden ──────────────────────────────────────────────────────
# Generate admin token with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=change_me_generate_with_openssl_rand_base64_48
VAULTWARDEN_SIGNUPS_ALLOWED=false

# ── Grafana ──────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# ── SMTP (used by GitLab, Vaultwarden for email notifications) ───────
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ── LLM Model Selection ──────────────────────────────────────────────
# Model to pull automatically on first boot (see: https://ollama.com/library)
OLLAMA_DEFAULT_MODEL=llama3.1:70b
