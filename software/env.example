# ====================================================================
# Sovereign Mini Datacenter - Environment Configuration Template
# Copy to .env and fill in all values before running setup.sh
# ====================================================================

# -- TLS / Let's Encrypt ---------------------------------------------
# Email used for ACME certificate registration
ACME_EMAIL=admin@yourdomain.com

# -- Domain Names ----------------------------------------------------
# Set these to your actual public or LAN domain names.
# For LAN-only: use *.local (self-signed) or split-horizon DNS.
DOMAIN_TRAEFIK=traefik.yourdomain.com
DOMAIN_WEBUI=ai.yourdomain.com
DOMAIN_GITLAB=gitlab.yourdomain.com
DOMAIN_PROJECTS=projects.yourdomain.com
DOMAIN_NEXTCLOUD=cloud.yourdomain.com
DOMAIN_VAULT=vault.yourdomain.com
DOMAIN_GRAFANA=grafana.yourdomain.com
DOMAIN_PROMETHEUS=metrics.yourdomain.com
DOMAIN_MAILCOW=mail.yourdomain.com
# DOMAIN_VPN must also be set as server_url in vpn/config/headscale.yaml.
DOMAIN_VPN=vpn.yourdomain.com

# -- Traefik Dashboard Auth -------------------------------------------
# Generate with: echo $(htpasswd -nb admin yourpassword) | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$changeme$$replace_this_with_htpasswd_output

# -- Open-WebUI & Qdrant RAG ------------------------------------------
WEBUI_SECRET_KEY=change_me_to_a_strong_random_string_min_32_chars

# -- GitLab CE --------------------------------------------------------
# No additional secrets needed beyond domain; root password set on first login.

# -- OpenProject ------------------------------------------------------
OPENPROJECT_SECRET=change_me_to_a_strong_random_string_min_64_chars

# -- Nextcloud --------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_strong_password

# -- Vaultwarden ------------------------------------------------------
# Generate admin token with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=change_me_generate_with_openssl_rand_base64_48
VAULTWARDEN_SIGNUPS_ALLOWED=false

# -- Grafana ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# -- SMTP -------------------------------------------------------------
# After mailcow is running, point these to your mailcow instance:
#   SMTP_HOST=mailcow-postfix
#   SMTP_PORT=587
#   SMTP_USER=notifications@yourdomain.com
# For external SMTP (before mailcow is set up):
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# -- LLM Model Selection ----------------------------------------------
# Default model for `smdc` commands (see: https://ollama.com/library).
# Nothing pulls it automatically; after first boot run:
#   docker exec sovereign_ollama ollama pull <model>
OLLAMA_DEFAULT_MODEL=llama3.1:70b

# -- Mailcow ----------------------------------------------------------
# MAILCOW_HOSTNAME must match your MX record and PTR (reverse DNS)
MAILCOW_HOSTNAME=mail.yourdomain.com

# -- Encrypted Backup (Restic) ----------------------------------------
# The backup container persists only /var/backups/sovereign (the
# backup_storage volume). Any other value must be a remote repository
# (s3:, sftp:, rest:), or snapshots are lost when the container is recreated.
RESTIC_REPOSITORY=/var/backups/sovereign
RESTIC_PASSWORD=change_me_to_a_strong_restic_backup_password
RESTIC_S3_KEY=
RESTIC_S3_SECRET=
BACKUP_INTERVAL_SECONDS=86400

# -- Power & Thermal Telemetry ----------------------------------------
# Set to 'false' when connected to real Victron VE.Direct USB and LiFePO4 BMS RS485
SIMULATE_POWER_DATA=true
# ==============================================================================
# 11. SPACE & SATELLITE COMMUNICATIONS (DTN / BPv7)
# ==============================================================================
# Host port for the space exporter (the container side is fixed at 9102).
SPACE_EXPORTER_PORT=9102
GROUND_STATION_LAT=37.9838
GROUND_STATION_LON=23.7275
GROUND_STATION_NAME=Sovereign-Ground-01

# ==============================================================================
# OPTIONAL SETTINGS
# Everything below is commented out and shows the built-in default. Uncomment a
# line only to change it.
# ==============================================================================

# -- Compose project name ---------------------------------------------
# Prefix of the stack's volumes and network (<project>_gitlab_data, ...).
# Default: the directory name, "software". backup.sh uses it to find the volumes.
#COMPOSE_PROJECT_NAME=software

# -- Encrypted Backup: database dumps ---------------------------------
# Host directory where `backup.sh` writes the application-consistent database
# dumps (mode 0700, contains plaintext data). The backup container mounts it
# read-only. See software/backup/README.md.
#BACKUP_DUMP_DIR=/var/backups/sovereign-dumps
# The backup container refuses to run when the host's dumps are older than this
# (seconds; default 26 h for a daily `backup.sh --dump-only` job).
#BACKUP_DUMP_MAX_AGE_SECONDS=93600
# SMDC state directory (wallets, ledgers, node keys) to include in the dumps.
# Default: SMDC_STATE_DIR if set, otherwise it is skipped (and reported).
#BACKUP_SMDC_STATE_DIR=/home/<user>/.smdc
# Extra arguments for `gitlab-backup create`, e.g. STRATEGY=copy.
#GITLAB_BACKUP_ARGS=

# -- Autonomous Agents overlay (--with-agents) -------------------------
# Seconds between the sentinel's polls of the power exporter (minimum 1).
#SENTINEL_POLL_INTERVAL_SECONDS=30
# GitLab access token (api scope) for the merge-request reviewer. Empty: the
# reviewer starts but cannot read or comment on merge requests.
#GITLAB_REVIEWER_TOKEN=
# Knowledge indexer. DOCS_WATCH_DIR is a path INSIDE the container; the default
# is the data directory of the Nextcloud volume mounted at /data/nextcloud.
#DOCS_WATCH_DIR=/data/nextcloud/data
# Comma-separated globs relative to DOCS_WATCH_DIR; only matching files are
# indexed. Set it to empty (DOCS_INCLUDE_GLOB=) to index everything.
#DOCS_INCLUDE_GLOB=*/files/**
# Comma-separated directory names that are never entered.
#DOCS_EXCLUDE_DIRS=appdata_*,files_trashbin,files_versions,files_external,cache,uploads,.*
# Files larger than this many bytes are skipped (default 5 MiB).
#DOCS_MAX_FILE_BYTES=5242880
# Host directory with a Nextcloud layout (containing data/) to index instead of
# the nextcloud_data volume.
#NEXTCLOUD_DATA_PATH=/srv/nextcloud

# ==============================================================================
# HOST-SIDE TOOLS - NOT READ FROM THIS FILE
# These are read from the environment of the process that runs the tool (your
# shell, the cron line or the systemd unit), not by Docker Compose. They are
# listed here so that every knob is documented in one place.
# ==============================================================================

# -- software/telemetry/load_shedder.sh (cron / systemd timer) --------
# log   = only log the decision; never pauses or resumes anything (default).
# pause = `docker pause` LOAD_SHED_CONTAINER on low battery / overheating and
#         resume it only after every recorded cause has verifiably cleared.
#LOAD_SHED_ACTION=log
#LOAD_SHED_CONTAINER=sovereign_ollama
# Marker file kept while the script holds a pause (records the cause).
#LOAD_SHED_STATE_FILE=$HOME/.local/state/sovereign-dc/load_shedder.paused

# -- smdc dashboard ----------------------------------------------------
# Bind address. Anything other than loopback requires SMDC_DASHBOARD_TOKEN.
#SMDC_DASHBOARD_HOST=127.0.0.1
# Bearer token for control POSTs and for non-local reads. Unset: remote clients
# cannot control the node. Generate with: openssl rand -hex 32
#SMDC_DASHBOARD_TOKEN=
# Extra browser origins allowed by CORS (comma-separated, or *). Unset: loopback only.
#SMDC_CORS_ORIGIN=

# -- Mesh sync (mesh_sync.py, `smdc mesh`) -----------------------------
# Seconds between peer health sweeps (minimum 1).
#MESH_POLL_INTERVAL_SECONDS=60
# Cluster topology YAML. Unset: cluster_config.yaml next to mesh_sync.py, else the
# built-in three-site reference topology. Reading the file needs PyYAML, which is
# installed with the `smdc` package but NOT in the python:3.11-alpine image the
# agent containers use: there, a configured path is logged as unusable and the
# built-in topology is used. No overlay sets this variable.
#CLUSTER_CONFIG_PATH=/path/to/cluster_config.yaml

# -- Standalone stacks (Mailcow override, LoRa gateway) ----------------
# Name of the core stack's network; only needed when the core stack does not run
# under the default project name. Set it in mailcow.conf for Mailcow, or in the
# shell that starts software/mesh/lora/docker-compose.lora.yml.
#SOVEREIGN_NET_NAME=software_sovereign_net
